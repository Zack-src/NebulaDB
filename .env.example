# The one configuration file: copy to `.env` (gitignored). Read by `npm run dev`,
# `npm start`, the server scripts, `npm run db:up` and `docker compose`.
# The defaults below work as-is for a local test; CHANGE BOTH VALUES for anything
# beyond testing (they are public in git).

# Required. PostgreSQL password; letters and digits only (it goes into a URL).
# Fixed when the database volume is first created: changing it later needs
# `ALTER USER nebuladb PASSWORD '...'` in the database too.
NEBULADB_POSTGRES_PASSWORD=nebuladbtest123

# Required. Encrypts stored DB credentials, 2FA and webhook secrets: `openssl rand -hex 32`.
# Changing it later makes stored credentials undecryptable.
NEBULADB_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session cookies aren't marked Secure on plain HTTP; true once served over TLS.
NEBULADB_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Optional: ports (defaults shown). Everything follows them: the web dev proxy,
# the database URL, the Docker port mappings.
# ---------------------------------------------------------------------------

# Server (API + WebSocket; also the app's port with `npm start` and Docker).
# PORT=3001
# Web dev server (`npm run dev`).
# NEBULADB_WEB_PORT=5173
# Host port of the PostgreSQL started by `npm run db:up` (5433 so it doesn't
# collide with a PostgreSQL installed natively on 5432).
# NEBULADB_POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Optional: everything else, commented out at its default.
# Full reference: README "Configuration" and apps/server/src/config.ts.
# ---------------------------------------------------------------------------

# Another PostgreSQL than the one of `npm run db:up` (ignored by Docker, which uses its own).
# NEBULADB_DATABASE_URL=postgres://nebuladb:password@localhost:5432/nebuladb
# Max connections the server keeps open to its own PostgreSQL (1-200).
# NEBULADB_DATABASE_POOL_SIZE=10

# Previous NEBULADB_SECRET, only while rotating the key (old data stays readable).
# NEBULADB_SECRET_PREVIOUS=

# NEBULADB_LOG_LEVEL=info
# Extra CORS origins beyond the app's own host, comma-separated.
# NEBULADB_ALLOWED_ORIGINS=
# NEBULADB_MAX_BODY_MB=4
# NEBULADB_MAX_WS_FRAME_MB=8

# Reverse proxy trust: false | true | hop count (1 = single nginx) | IP/CIDR list.
# NEBULADB_TRUST_PROXY=false

# Public URL users reach the app at; required when SMTP is configured.
# NEBULADB_PUBLIC_URL=https://nebuladb.example.com

# Outgoing email (invitations, password reset). Unset host = email off.
# NEBULADB_SMTP_HOST=
# NEBULADB_SMTP_PORT=587
# NEBULADB_SMTP_SECURE=false
# NEBULADB_SMTP_USER=
# NEBULADB_SMTP_PASSWORD=
# NEBULADB_SMTP_FROM="NebulaDB <noreply@example.com>"

# Scheduled backups of every project (0 = off).
# NEBULADB_BACKUP_INTERVAL_HOURS=0
# NEBULADB_BACKUP_DIR=./backups
# NEBULADB_BACKUP_KEEP=7

# Retention in days (0 = forever).
# NEBULADB_AUDIT_RETENTION_DAYS=365
# NEBULADB_QUERY_STATS_RETENTION_DAYS=
# NEBULADB_DB_ACTIVITY_RETENTION_DAYS=

# Minutes between connectivity checks of saved connections (0 = off).
# NEBULADB_CONNECTION_HEALTH_INTERVAL_MINUTES=15

# Backups of connected databases (the "Sauvegardes" tab).
# NEBULADB_DATABASE_BACKUP_DIR=./data/database-backups
# NEBULADB_DATABASE_BACKUP_MAX_MB=512
# NEBULADB_DATABASE_BACKUP_RETENTION_DAYS=30

# Seed CSV storage and limits; import-by-path folder for administrators (unset = off).
# NEBULADB_SEED_DIR=./data/seeds
# NEBULADB_SEED_FILE_MAX_GB=20
# NEBULADB_SEED_MAX_KEYS=5000000
# NEBULADB_SEED_IMPORT_DIR=

# Restrict SQLite connections to files inside this directory (unset = any path).
# NEBULADB_SQLITE_DIR=

# Webhooks: private/loopback targets are refused unless allowed here or BLOCK_PRIVATE=0.
# NEBULADB_WEBHOOK_BLOCK_PRIVATE=1
# NEBULADB_WEBHOOK_ALLOWED_HOSTS=

# Set to 1 to log server-side calls slower than 20ms (perf diagnostics only).
# NEBULADB_PERF_LOG=1

# Optional: physical Docker volume names, to reuse existing volumes when upgrading.
# NEBULADB_POSTGRES_VOLUME=nebuladb-postgres
# NEBULADB_DATA_VOLUME=nebuladb-data
