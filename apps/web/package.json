{
  "name": "@nebuladb/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build && node ../../scripts/precompress.mjs dist",
    "preview": "vite preview",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && tsx --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"src/**/*.test.ts\"",
    "test:e2e": "tsx --test --test-concurrency=8 e2e/**/*.e2e.ts",
    "check:circular": "madge --circular --extensions ts --ts-config tsconfig.json src",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@nebuladb/dbml-engine": "*",
    "@nebuladb/shared": "*",
    "@xyflow/svelte": "^1.7.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lib0": "^0.2.119",
    "qrcode": "^1.5.4",
    "svelte": "^5.57.2",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/smtp-server": "^3.5.13",
    "postcss": "^8.5.26",
    "postcss-import": "^17.0.1",
    "smtp-server": "^3.19.13",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
