{
  "name": "@nebuladb/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test \"dist/**/*.test.js\"",
    "test:coverage": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"dist/**/*.test.js\"",
    "bench": "tsx scripts/bench.ts",
    "check:circular": "madge --circular --extensions ts src/index.ts",
    "backup": "tsx src/infrastructure/backup.ts",
    "restore": "tsx src/infrastructure/restore.ts",
    "bootstrap-admin": "tsx src/bootstrap-admin.ts",
    "bootstrap-admin:prod": "node dist/bootstrap-admin.js",
    "export-instance": "tsx src/export-instance.ts",
    "export-instance:prod": "node dist/export-instance.js",
    "import-instance": "tsx src/import-instance.ts",
    "import-instance:prod": "node dist/import-instance.js",
    "rotate-secret": "tsx src/rotate-secret.ts",
    "migrate-from-sqlite": "tsx src/migrate-from-sqlite.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/lib-storage": "^3.1151.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@google-cloud/bigquery": "^9.2.0",
    "@nebuladb/dbml-engine": "*",
    "@nebuladb/shared": "*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.0",
    "lib0": "^0.2.117",
    "mssql": "^12.7.0",
    "mysql2": "^3.23.3",
    "nodemailer": "^10.0.10",
    "openid-client": "^6.8.8",
    "oracledb": "^26.0.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@readme/openapi-parser": "^9.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.2",
    "@types/oracledb": "^26.0.0",
    "@types/pg": "^8.21.0",
    "@types/smtp-server": "^3.5.13",
    "@types/ssh2": "^1.15.6",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/ws": "^8.18.1",
    "jose": "^6.2.12",
    "smtp-server": "^3.19.13",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
