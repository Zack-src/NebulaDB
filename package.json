{
  "name": "nebuladb",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Self-hosted DBML schema diagram editor with multi-user editing and history.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w packages/shared && npm run build -w packages/dbml-engine",
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:server": "npm run dev -w apps/server",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --wait postgres",
    "db:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml stop postgres",
    "build": "npm run build -w packages/shared && npm run build -w packages/dbml-engine && npm run build -w apps/server && npm run build -w packages/cli && npm run build -w apps/web",
    "start": "node apps/server/dist/index.js",
    "bench:web": "node scripts/bench-web.mjs",
    "bench:server": "npm run bench -w apps/server --",
    "backup": "npm run backup -w apps/server --",
    "restore": "npm run restore -w apps/server --",
    "bootstrap-admin": "npm run bootstrap-admin -w apps/server --",
    "rotate-secret": "npm run rotate-secret -w apps/server --",
    "migrate-from-sqlite": "npm run migrate-from-sqlite -w apps/server --",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w apps/web",
    "check:circular": "npm run check:circular --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22 <26"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "madge": "^8.0.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true,
    "ssh2@1.17.0": true,
    "cpu-features": false,
    "oracledb": false
  },
  "overrides": {
    "@azure/msal-node": "^7.1.1"
  }
}
